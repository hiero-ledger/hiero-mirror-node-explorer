{
  "name": "@hiero-ledger/hiero-explorer",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "dev:http": "cp networks-config-http-example.json ./public/networks-config.json  && vite --config nossl.config.ts",
    "build": "run-p type-check build-only",
    "clean": "rm -rf dist",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "cover:unit": "vitest run --coverage",
    "test:e2e": "START_SERVER_AND_TEST_INSECURE=1 start-server-and-test dev https://localhost:5173 'cypress run --browser chrome --e2e'",
    "test:e2e:dev": "START_SERVER_AND_TEST_INSECURE=1 start-server-and-test 'vite dev --port 5173' https://localhost:5173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-pattern ../.gitignore",
    "docker:build": "npm run build && docker build . --tag ghcr.io/hiero-ledger/hiero-mirror-node-explorer/hiero-explorer:latest",
    "docker:start": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "sourcify:setup": "bash scripts/sourcify-setup.sh",
    "sourcify:start": "npm run sourcify:setup && docker compose -f ./sourcify-setup/docker-compose.yaml up -d && sleep 3 && open https://localhost/server/health",
    "sourcify:stop": "docker compose -f ./sourcify-setup/docker-compose.yaml down"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "@ethereum-sourcify/bytecode-utils": "1.6.2",
    "@hiero-ledger/proto": "2.31.0",
    "@hiero-ledger/sdk": "2.88.0",
    "@hedera-name-service/hns-resolution-sdk": "2.0.15",
    "@kabuto-sh/ns": "0.15.2",
    "@lucide/vue": "1.46.0",
    "@oruga-ui/oruga-next": "0.14.3",
    "@oruga-ui/theme-oruga": "0.10.0",
    "@vuepic/vue-datepicker": "14.0.0",
    "@vueuse/core": "14.4.0",
    "@walletconnect/sign-client": "2.25.0",
    "@reown/appkit": "1.8.23",
    "axios": "1.20.0",
    "base32-decode": "1.0.0",
    "base32-encode": "2.0.0",
    "brotli-compress": "2.2.2",
    "chart.js": "4.5.1",
    "d3": "7.9.0",
    "d3-geo": "3.1.1",
    "ethers": "6.17.0",
    "file-saver": "2.0.5",
    "jszip": "3.10.2",
    "multiformats": "14.0.5",
    "prismjs": "1.30.0",
    "topojson-client": "3.1.0",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@cypress/code-coverage": "4.0.3",
    "@eslint/js": "10.0.1",
    "@tsconfig/node18": "18.2.7",
    "@types/d3": "7.4.3",
    "@types/d3-geo": "3.1.1",
    "@types/file-saver": "2.0.7",
    "@types/jsdom": "30.0.0",
    "@types/prismjs": "1.26.6",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/web-worker": "5.0.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "axios-mock-adapter": "2.1.0",
    "cypress": "16.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-cypress": "7.0.2",
    "eslint-plugin-vue": "10.11.0",
    "fast-check": "4.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "npm-run-all": "4.1.5",
    "resize-observer-polyfill": "1.5.1",
    "start-server-and-test": "3.0.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "@grpc/grpc-js": "1.12.7",
    "js-yaml": "4.3.2",
    "protobufjs": "8.6.6",
    "ethers": {
      "ws": "8.21.0"
    },
    "axios": "1.20.0",
    "qs": "6.16.0"
  },
  "allowScripts": {
    "fsevents": true,
    "vue-demi": true,
    "@reown/appkit": true,
    "cbor-extract": true,
    "cypress": true,
    "esbuild": true,
    "keccak": true
  }
}
